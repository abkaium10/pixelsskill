# Neon PostgreSQL (pooled) and direct connection for migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Public site URL (used for canonical URLs, sitemap). NEVER derived from request headers.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Cloudinary (API secret is server-only)
CLOUDINARY_CLOUD_NAME="your-cloud"
CLOUDINARY_API_KEY="000000000000000"
CLOUDINARY_API_SECRET="replace-me"
# Initial admin created by `npm run db:seed` (choose your own strong password)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-a-long-password"
